{
  "name": "runway-startup-game",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx scripts/sync-sim-data.ts && next dev",
    "build": "tsx scripts/sync-sim-data.ts && next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:game": "tsx scripts/test-game.ts",
    "test:ui": "tsx scripts/test-ui.tsx",
    "test:sim": "tsx scripts/test-sim.ts",
    "osm:fetch": "NODE_OPTIONS=--max-old-space-size=8192 tsx scripts/fetch-osm-london.ts && pnpm simplify:sim",
    "simplify:sim": "NODE_OPTIONS=--max-old-space-size=8192 tsx scripts/simplify-osm-london.ts",
    "pack:sim": "NODE_OPTIONS=--max-old-space-size=8192 tsx scripts/pack-sim-mesh.ts",
    "sync:sim-data": "tsx scripts/sync-sim-data.ts"
  },
  "dependencies": {
    "earcut": "^3.2.3",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/earcut": "^3.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "osm-pbf-parser": "^2.3.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "puppeteer-core": "^25.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.0",
    "typescript": "^5"
  }
}
